{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nocturne",
  "version": "0.1.0",
  "identifier": "dev.atherion.nocturne",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nocturne",
        "width": 1220,
        "height": 780,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#04060c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
